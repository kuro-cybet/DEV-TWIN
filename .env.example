# DevTwin Environment Configuration

# Backend
PORT=8000
HOST=0.0.0.0
# For local SQLite (default zero-config fallback):
DATABASE_URL=sqlite:///./devtwin.db
# For PostgreSQL (Docker / Production Render / Supabase / Neon):
# DATABASE_URL=postgresql://devtwin:devtwin@localhost:5432/devtwin

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Upload & Ingestion settings
MAX_UPLOAD_SIZE_MB=50
STORAGE_DIR=./data/projects

# Frontend (Vite)
VITE_API_URL=http://localhost:8000/api/v1
